def display_guess(guess):
    # loops through letters in each guess and applies correct color to each
    for letter in guess:
        if letter in application_data['secret_word'] and letter == application_data['secret_word'][guess.index(letter)]:
            letter = letter.upper()
            print(f"{GREEN}{letter}{RESET}", end=' ')
        elif letter in application_data['secret_word']:
            letter = letter.upper()
            print(f'{YELLOW}{letter}{RESET}', end=' ')
        else:
            letter = letter.upper()
            print(f"{GREY}{letter}{RESET}", end=' ')
    # idrk what the game status is but this changes it all to true POGGIES
    if guess == application_data['secret_word']:
        application_data['game_status'] = [True, True, True, True, True]
    # adds space in between each letter and then adds a new line at the end of the guess
    print()

def display_board():
    # prints the current guesses and the number of guesses remaining
    print("current guesses: ")
    for guess in application_data['player_guesses']:
        display_guess(guess)
    print(f"Guesses remaining: {application_data['guesses_remaining']}")
    print(f"Game status: {application_data['game_status']}")


